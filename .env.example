# Copy this file to .env and set your own secret key.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Identify the application when calling Nominatim; a project URL or email can be added.
WEATHER_USER_AGENT=ContactManagement/1.0 (Django contact manager)
# Providers can be changed without editing application code.
WEATHER_GEOCODING_URL=https://nominatim.openstreetmap.org/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
